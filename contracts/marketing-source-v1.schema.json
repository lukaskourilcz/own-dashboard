{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "marketing-source/1"
    },
    "brand": {
      "type": "string",
      "enum": [
        "dneskai",
        "devshark"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "article",
        "question",
        "coding-task",
        "instagram-reference"
      ]
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonicalUrl": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    },
    "locale": {
      "type": "string",
      "enum": [
        "cs",
        "en"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "eligible": {
      "type": "boolean"
    },
    "eligibilityReason": {
      "type": "string",
      "maxLength": 300
    },
    "content": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "difficulty": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 50
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 12000
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "answer": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 6000
            },
            {
              "type": "null"
            }
          ]
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 12000
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2048,
                "format": "uri"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "excerpt": {
                "type": "string",
                "maxLength": 2000
              },
              "checkedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "timecodeSeconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "url",
              "title",
              "excerpt",
              "checkedAt"
            ],
            "additionalProperties": false
          }
        },
        "image": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "uri"
                },
                "alt": {
                  "type": "string",
                  "maxLength": 1000
                },
                "licence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "url",
                "alt",
                "licence"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "body",
        "category",
        "difficulty",
        "code",
        "options",
        "answer",
        "explanation",
        "evidence",
        "image"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "brand",
    "kind",
    "sourceId",
    "sourceRevision",
    "contentHash",
    "canonicalUrl",
    "locale",
    "observedAt",
    "expiresAt",
    "eligible",
    "eligibilityReason",
    "content"
  ],
  "additionalProperties": false
}
