{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "marketing-content/1",
        "marketing-content/2"
      ]
    },
    "brand": {
      "type": "string",
      "enum": [
        "dneskai",
        "devshark"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2200
    },
    "format": {
      "type": "string",
      "enum": [
        "carousel",
        "post",
        "reel",
        "thread",
        "story"
      ]
    },
    "sources": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sourceRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "sourceId",
          "sourceRevision",
          "contentHash"
        ],
        "additionalProperties": false
      }
    },
    "knowledgeIds": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "assets": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "video/mp4"
            ]
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 7680
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 7680
          },
          "alt": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "url",
          "sha256",
          "mimeType",
          "width",
          "height",
          "alt"
        ],
        "additionalProperties": false
      }
    },
    "account": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "platform": {
          "type": "string",
          "enum": [
            "instagram",
            "threads"
          ]
        },
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "platform",
        "handle"
      ],
      "additionalProperties": false
    },
    "collaborators": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._]{1,30}$"
      }
    },
    "scheduledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "timeZone": {
      "type": "string",
      "const": "Europe/Prague"
    },
    "templateVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "traceId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "deck": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "dneskai-slides/1"
        },
        "format": {
          "type": "string",
          "enum": [
            "carousel",
            "single-image"
          ]
        },
        "kit": {
          "type": "string",
          "enum": [
            "bold",
            "explainer",
            "magazine",
            "ticker",
            "spotlight"
          ]
        },
        "slides": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "cover-photo",
                  "figure",
                  "split",
                  "statement",
                  "sources",
                  "single"
                ]
              },
              "variant": {
                "type": "string",
                "enum": [
                  "accent",
                  "ink",
                  "photo",
                  "type"
                ]
              },
              "headline": {
                "type": "string",
                "maxLength": 200
              },
              "body": {
                "type": "string",
                "maxLength": 700
              },
              "kicker": {
                "type": "string",
                "maxLength": 80
              },
              "credit": {
                "type": "string",
                "maxLength": 120
              },
              "sources": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              },
              "images": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "slot": {
                      "type": "string",
                      "pattern": "^image-[1-9]$"
                    },
                    "assetSha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "crop": {
                      "type": "object",
                      "properties": {
                        "focal": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "y": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "required": [
                            "x",
                            "y"
                          ],
                          "additionalProperties": false
                        },
                        "zoom": {
                          "type": "number",
                          "minimum": 1,
                          "maximum": 4
                        },
                        "fit": {
                          "type": "string",
                          "enum": [
                            "cover",
                            "contain"
                          ]
                        }
                      },
                      "required": [
                        "focal"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "slot",
                    "assetSha256"
                  ],
                  "additionalProperties": false
                }
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "type",
              "headline",
              "images",
              "alt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "format",
        "slides"
      ],
      "additionalProperties": false
    },
    "engagement": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "pattern": "^[A-Z0-9]{1,24}$"
        },
        "replyMessage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "publicReply": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "keyword",
        "replyMessage"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "brand",
    "title",
    "caption",
    "format",
    "sources",
    "knowledgeIds",
    "assets",
    "account",
    "scheduledAt",
    "timeZone",
    "templateVersion",
    "promptVersion",
    "model",
    "traceId"
  ],
  "additionalProperties": false
}
