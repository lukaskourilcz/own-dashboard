  "rules": [
    "Use the production files as they are. The name is drawn as outlines; never redraw it or set it in a font.",
    "Keep the proportions: the viewBox is 50 -708 4217.8 708, about 5.96 : 1.",
    "Clear space on every side equals the height of the dot over the i, about 27 % of the logotype's height.",
    "Minimum height is 16 px. Below that, use the square mark.",
    "The light file goes on white or paper (#ffffff, #f7f7f5), the dark file on #14161a, the white mono on solid blue or a photograph, and the black mono in one-colour print.",
    "The square mark is for favicons, app icons, social avatars and any other square format.",
    "Production files never crop the square mark to a circle; the platform does that for avatars.",
    "The blinking square is only for SVG inlined on the web. Favicons and avatars use the static file."
  ],
  "doNots": [
    "Do not recolour the logotype.",
    "Do not add shadows or gradients.",
    "Do not resize the Ai.",
    "Do not set the name in a font.",
    "Do not stretch or squash the logotype.",
    "Do not use gradients, glass, glow, neon or cyberpunk ornament; surfaces are flat.",
    "Do not round panels: zero radii, no decorative elevation."
  ],
  "socialRules": [],
  "typography": [
    "The logotype is Poppins Black converted to outlines. Poppins is not a web font here and does not need to be installed.",
    "Space Grotesk sets display headlines, section headings, navigation and controls.",
    "Source Serif 4 sets article prose, deks, definitions and descriptive card copy.",
    "IBM Plex Mono sets dates, issue identifiers, source ids, tags, captions and measured values.",
    "Carousels set headlines in Space Grotesk, words in Source Serif 4 and labels in IBM Plex Mono, from the OFL files in studio/fonts."
  ],
