# Copy to .env (gitignored) or export these in your shell before launching the
# MCP server. The service-role key bypasses RLS — keep it local, never commit.
SUPABASE_URL=https://gcctapykhrdyxikieemn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Your Supabase auth user UUID (Supabase → Authentication → Users, or
# `select id, email from auth.users;`). Notes are created as this user.
DASHBOARD_USER_ID=your-auth-user-uuid
