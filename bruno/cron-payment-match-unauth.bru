meta {
  name: Payment-match cron requires auth
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/cron/payment-match
  body: none
  auth: none
}

headers {
  Authorization: Bearer wrong-secret
}

assert {
  res.status: eq 403
}

settings {
  followRedirects: false
}

docs {
  The payment matcher marks invoices paid, so an unauthenticated caller must
  never reach it. Same gate as the other cron routes, rejectUnlessCron: a
  wrong or absent bearer returns 403, and with CRON_SECRET unset or blank
  every call does, so this assertion holds on any deployment (see
  bruno/README.md).
}
