meta {
  name: Quick-add requires auth
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/quick-add
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

body:json {
  {
    "input": "buy milk tomorrow"
  }
}

assert {
  res.status: eq 401
}

settings {
  followRedirects: false
}

docs {
  An unauthenticated POST must never invoke the LLM. We send a same-origin
  Origin header so the request clears the CSRF gate (rejectCrossOrigin), then
  the handler's own getUser() returns 401 "Not authenticated." — the LLM is
  never reached. (Drop the Origin header and it's rejected earlier with 403
  "Missing Origin header.", the CSRF defense.)
}
