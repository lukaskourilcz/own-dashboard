meta {
  name: GitHub repos require auth
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/github/repos
  body: none
  auth: none
}

assert {
  res.status: eq 401
}

settings {
  followRedirects: false
}

docs {
  An unauthenticated request must never reach the repos handler. API routes are
  exempt from the page-level session redirect, so the handler gates itself:
  getUser() finds no user and returns 401 "Not authenticated." before any
  GitHub call happens.
}
