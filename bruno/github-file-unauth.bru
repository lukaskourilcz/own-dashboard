meta {
  name: GitHub file read requires auth
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/github/file?owner=octocat&repo=hello-world&path=README.md
  body: none
  auth: none
}

assert {
  res.status: eq 401
}

settings {
  followRedirects: false
}

docs {
  An unauthenticated file read must never proxy a file on an anonymous caller's
  behalf. API routes are exempt from the page-level session redirect, so the
  handler gates itself: getUser() finds no user and returns 401 before any
  GitHub Contents call happens.
}
