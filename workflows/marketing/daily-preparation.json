      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const requests = [];\nfor (const item of $input.all()) {\n  const response = item.json;\n  if (!['dneskai','devshark'].includes(response.brand) || !Array.isArray(response.entries)) continue;\n  for (const entry of response.entries) {\n    if (typeof entry.id !== 'string' || !['instagram','threads'].includes(entry.platform)) continue;\n    requests.push({json:{operation:'enqueue',brand:response.brand,entryId:entry.id,platform:entry.platform}});\n  }\n}\nreturn requests.slice(0,8);"
      }
    },
