      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((item,index)=>{\n const response=item.json;\n const valid=response.brand==='devshark'&&Array.isArray(response.dates);\n const dates=valid?response.dates.filter(date=>typeof date==='string'&&/^\\d{4}-\\d{2}-\\d{2}$/.test(date)).slice(0,7):[];\n return {json:{brand:'devshark',mode:'discovery-and-owner-review',status:'held',dates,observedDeliverableCount:valid&&Number.isInteger(response.planning?.calendarObservedCount)?response.planning.calendarObservedCount:0,supportedReleasedCount:valid&&Array.isArray(response.entries)?response.entries.length:0,heldEntryCount:valid&&Array.isArray(response.heldEntries)?response.heldEntries.length:0,heldUnsupportedStoryCount:valid&&Number.isInteger(response.heldUnsupportedStoryCount)?response.heldUnsupportedStoryCount:0,sourcePacketCount:valid&&Array.isArray(response.packets)?response.packets.length:0,sourceHoldCount:valid&&Array.isArray(response.held)?response.held.length:0,calendarHasMore:response.planning?.calendarHasMore===true,requestedDeliverableQuota:42,automaticallyGenerated:0,providerCalls:0,remainingAdmissions:null,jobAdmissionsPerRolling24Hours:8,pilotLifetimeJobs:3,ownerReviewRequired:true,holdCodes:valid?['weekly-paid-admission-extension-required','thread-variants-unimplemented','story-publication-unsupported','weekly-asset-window-required']:['source-discovery-unavailable']},pairedItem:{item:index}};\n});"
      }
