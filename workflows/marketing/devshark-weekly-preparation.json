        "jsCode": "const today=$now.setZone('Europe/Prague');\nconst sunday=today.plus({days:(7-today.weekday)%7});\nconst dates=Array.from({length:7},(_,index)=>sunday.plus({days:index}).toISODate());\nreturn [{json:{operation:'discover',brand:'devshark',dates}}];"
