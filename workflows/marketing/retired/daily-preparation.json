    {
      "id": "419a513e-0734-50c7-9ef9-6ac93e31d4d1",
      "name": "Actual calendar entries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const inputs=$input.all();\nconst total=inputs.reduce((sum,item)=>sum+(item.json.brand==='dneskai'&&Array.isArray(item.json.entries)?item.json.entries.length:0),0);\nif(total>8)return [];\nconst requests = [];\nfor (const [index,item] of inputs.entries()) {\n  const response = item.json;\n  if (response.brand !== 'dneskai' || !Array.isArray(response.entries)) continue;\n  if (response.planning?.calendarHasMore || response.entries.length > 8) continue;\n  if (!Array.isArray(response.packets) || !response.packets.some(packet => packet?.eligible === true)) continue;\n  for (const entry of response.entries) {\n    if (typeof entry.id !== 'string' || !['instagram','threads'].includes(entry.platform)) continue;\n    requests.push({json:{operation:'enqueue',brand:'dneskai',entryId:entry.id,platform:entry.platform},pairedItem:{item:index}});\n  }\n}\nreturn requests;"
      }
    },
