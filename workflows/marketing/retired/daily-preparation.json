    {
      "id": "0f83729c-1c18-492a-ac86-26d34ea3a504",
      "name": "Daily preparation holds",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const inputs=$input.all();\nconst total=inputs.reduce((sum,item)=>sum+(item.json.brand==='dneskai'&&Array.isArray(item.json.entries)?item.json.entries.length:0),0);\nreturn inputs.map((item,index) => {\n  const response=item.json;\n  const entries=Array.isArray(response.entries)?response.entries:[];\n  const sourceReady=Array.isArray(response.packets)&&response.packets.some(packet=>packet?.eligible===true);\n  const held=total>8||!sourceReady||response.planning?.calendarHasMore===true||entries.length>8||response.brand!=='dneskai';\n  return {json:{brand:'dneskai',phase:'discovery',status:held?'held':'admission-required',observedEntryCount:entries.length,totalRequestedCount:total,heldEntryCount:Array.isArray(response.heldEntries)?response.heldEntries.length:0,heldUnsupportedStoryCount:Number.isInteger(response.heldUnsupportedStoryCount)?response.heldUnsupportedStoryCount:0,holdCode:response.brand!=='dneskai'?'source-discovery-unavailable':!sourceReady?'fresh-approved-source-required':response.planning?.calendarHasMore||entries.length>8||total>8?'daily-capacity-review-required':null,jobAdmissionsPerRolling24Hours:8,pilotLifetimeJobs:3,remainingAdmissions:null,approvalRequired:true},pairedItem:{item:index}};\n});"
      }
    }
