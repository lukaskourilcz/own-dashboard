      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().flatMap(item => {\n  const response = item.json;\n  if (!['dneskai','devshark'].includes(response.brand)) return [];\n  const packets = Array.isArray(response.packets) ? response.packets : [];\n  const sourceIds = [...new Set(packets.filter(packet=>packet && typeof packet.sourceId==='string').map(packet=>packet.sourceId))].slice(0,20);\n  return sourceIds.length ? [{json:{operation:'refresh',brand:response.brand,sourceIds}}] : [];\n});"
      }
    },
