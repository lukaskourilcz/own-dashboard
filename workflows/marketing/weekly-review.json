        "jsCode": "const today=$now.setZone('Europe/Prague');\nconst previousSunday=today.minus({days:(today.weekday%7)+7}).toISODate();\nreturn ['devshark','dneskai'].map(brand=>({json:{operation:'weekly-report',brand,weekStartsOn:previousSunday}}));"
