      "name": "Read-only weekly report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((item,index)=>{\n const response=item.json;\n const valid=response.mode==='read-only'&&['devshark','dneskai'].includes(response.brand);\n const statusCounts={};\n for(const status of ['queued','claimed','published','failed','reconciliation','cancelled'])statusCounts[status]=valid&&Number.isInteger(response.statusCounts?.[status])&&response.statusCounts[status]>=0?response.statusCounts[status]:null;\n return {json:{mode:'read-only',brand:valid?response.brand:null,weekStartsOn:valid&&typeof response.window?.startDate==='string'?response.window.startDate:null,status:valid?'observed':'held',coverage:valid&&['complete','partial'].includes(response.coverage)?response.coverage:'unavailable',sampleSize:valid&&Number.isInteger(response.sampleSize)?response.sampleSize:null,hasMore:valid?response.hasMore===true:null,statusCounts,providerMetricsStatus:'unavailable',providerMetrics:null,weeklyComparison:null,providerCalls:0,errorCode:valid?null:'weekly-report-unavailable'},pairedItem:{item:index}};\n});"
      }
    }
