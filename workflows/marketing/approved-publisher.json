      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const planned = $('Wait until exact UTC slot').item.json;\nconst rows = $input.all().flatMap(item => Array.isArray(item.json.outcomes) ? item.json.outcomes : []);\nconst pending = rows.some(row => row.publicationId === planned.publicationId && ['pending','reconciliation'].includes(row.status));\nreturn [{json:{publicationId:planned.publicationId,brand:planned.brand,reconcile:pending},pairedItem:{item:0}}];"
      }
