      "name": "Recorded ambiguous publications",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const records = [];\nfor (const item of $input.all()) {\n  const rows = Array.isArray(item.json.outcomes) ? item.json.outcomes : [];\n  for (const row of rows) {\n    const status = row.status ?? row.outcome?.status;\n    if (typeof row.publicationId === 'string' && ['reconciliation','pending'].includes(status)) records.push({json:{operation:'reconcile',publicationId:row.publicationId}});\n  }\n}\nreturn records.slice(0,5);"
      }
    },
