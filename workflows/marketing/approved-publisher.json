    {
      "id": "30c52e0f-075c-5605-a085-4aefdfe1dd36",
      "name": "Select publication planning scope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nreturn $input.all().map((item,index) => {\n  if (Object.prototype.hasOwnProperty.call(item.json,'body')) {\n    const body = item.json.body;\n    if (!body || typeof body !== 'object' || Array.isArray(body) || Object.keys(body).length !== 1 || !uuid.test(body.publicationId ?? '')) throw new Error('invalid-publication-hook');\n    return {json:{operation:'publication-plan',publicationId:body.publicationId},pairedItem:{item:index}};\n  }\n  return {json:{operation:'publication-plan'},pairedItem:{item:index}};\n});"
      }
    },
    {
      "id": "b449e0a7-5dc6-530a-823f-c7b3c43cc20a",
      "name": "Read exact approved publication plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://own-dashboard.example.invalid/api/marketing/n8n",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_HEADER_AUTH_CREDENTIAL_ID",
          "name": "OwnDashboard marketing n8n"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "9f31691d-6dc9-5017-b319-793894edb263",
      "name": "Bounded UTC publication slots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst now = Date.now();\nconst rows = $input.all().flatMap(item => Array.isArray(item.json.publications) ? item.json.publications : []).slice(0,8);\nconst seen = new Set();\nconst result = [];\nfor (const row of rows) {\n  const when = Date.parse(row.scheduledAt);\n  if (!uuid.test(row.publicationId ?? '') || !['dneskai','devshark'].includes(row.brand) || !Number.isFinite(when) || when > now + 24*60*60*1000 || when < now - 15*60*1000 || seen.has(row.publicationId)) throw new Error('invalid-publication-plan');\n  seen.add(row.publicationId);\n  result.push({json:{publicationId:row.publicationId,brand:row.brand,scheduledAt:new Date(when).toISOString()}});\n}\nreturn result.sort((a,b) => Date.parse(a.json.scheduledAt) - Date.parse(b.json.scheduledAt));"
      }
    },
    {
      "id": "fa455731-c6ae-541b-8661-eed4b27cadb7",
      "name": "One planned publication at a time",
      "type": "n8n-nodes-base.splitInBatches",
