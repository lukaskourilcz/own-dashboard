# Client-safe — exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Client-safe — OPTIONAL. PostHog product analytics + feature flags + session
# replay. Leave unset to disable entirely (the SDK never loads). Host defaults
# to EU (https://eu.i.posthog.com); override for US or a self-hosted instance.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# SERVER-ONLY — never expose. Required for Google token refresh
# (writes the per-user google_oauth row, bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# SERVER-ONLY — same Google OAuth client credentials configured in
# Supabase Auth > Providers > Google. Used to refresh access tokens
# against https://oauth2.googleapis.com/token.
GOOGLE_OAUTH_CLIENT_ID=xxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# SERVER-ONLY — OPTIONAL. Same GitHub OAuth App credentials configured in
# Supabase Auth > Providers > GitHub. Only needed to revoke the grant on
# "Disconnect GitHub" and to refresh expiring GitHub-App tokens. Classic
# OAuth App tokens never expire, so the Repos panel works without these —
# disconnect then just drops the stored token locally.
GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
