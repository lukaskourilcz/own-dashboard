# ---------------------------------------------------------------------------
# Required: client-safe Supabase connection
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Server-only Supabase administration. Required by privileged token refresh and
# provider-sync routes; never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# ---------------------------------------------------------------------------
# Optional: link enrichment
# ---------------------------------------------------------------------------
# Higher-throughput Jina Reader key for the AI-links Auto-fill route. Leave
# unset to use the anonymous Jina Reader tier.
JINA_API_KEY=

# Distributed rate limiting for API routes. Without these, development and
# small deployments use an in-memory per-instance fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Optional: Google and GitHub OAuth integrations
# ---------------------------------------------------------------------------
# Use the same Google OAuth client configured in Supabase Auth. These server-
# only credentials refresh Calendar provider tokens.
GOOGLE_OAUTH_CLIENT_ID=xxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# Use the same GitHub OAuth app configured in Supabase Auth. Repository reads
# work from the provider token; these credentials support revoke/refresh flows.
GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Optional: bank account data
# ---------------------------------------------------------------------------
# Bank sync runs through provider adapters (src/lib/bank/). Every provider is
# optional and independent: with none of them set, authenticated CSV statement
# import still works.
#
# GoCardless Bank Account Data (formerly Nordigen). App-level secret pair.
# Note that GoCardless has closed Bank Account Data to new signups, which is why
# the other two providers exist.
GOCARDLESS_SECRET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GOCARDLESS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Enable Banking (PSD2). Register an application, generate an RSA key pair and
# upload the public key; the application id comes back from their control panel.
# The private key is PEM, with literal \n escapes allowed on one line.
# Unset means the provider is listed as not set up and nothing calls it.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY=

# Fio banka has no variable here on purpose. Its API token belongs to one
# person's account rather than to the deployment, so it is stored per user in
# `bank_provider_credentials` (service-role only) through Finances → Connect
# bank → Fio banka.

# ---------------------------------------------------------------------------
# Optional: scheduled jobs, email, and external cron registry
# ---------------------------------------------------------------------------
# Strong shared secret sent as Bearer authorization to routes in vercel.json.
# Every /api/cron/* route answers 403 while it is unset.
CRON_SECRET=replace-with-a-long-random-secret
# Optional push-monitor URL pinged after a successful cron run (Uptime Kuma,
# Better Stack, UptimeRobot). Shared fallback for every scheduled job; set a
# per-job variable below to monitor them separately. Unset means unmonitored.
HEARTBEAT_URL=
HEARTBEAT_URL_BANK_SYNC=
HEARTBEAT_URL_PAYMENT_MATCH=
HEARTBEAT_URL_RENEWAL_WARNINGS=
HEARTBEAT_URL_JOBS_SCRAPE=
# Shared secret Uptime Kuma sends to /api/webhooks/uptime-kuma so a missed
# heartbeat becomes an in-app notification. Kuma's webhook must send it as an
# "Authorization: Bearer <token>" additional header; a ?token= query string is
# refused. Also needs DASHBOARD_OWNER_ID.
UPTIME_KUMA_WEBHOOK_TOKEN=
# Required only for renewal-warning email delivery.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=OwnDashboard <notifications@your-verified-domain.example>
# Bearer token for GET /api/crons/registry and POST /api/crons/log. Both answer
# 503 while it is unset (the log also needs DASHBOARD_OWNER_ID); nothing calls
# either today.
CRON_REGISTRY_TOKEN=
# Supabase auth.users UUID the app's own cron runs, the cron log endpoint and
# the Uptime Kuma receiver write under. Without it they record nothing.
DASHBOARD_OWNER_ID=

# ---------------------------------------------------------------------------
# Optional: privacy-conscious analytics and monitoring
# ---------------------------------------------------------------------------
# Leave PostHog unset to keep the SDK disabled. Host defaults to the EU ingest
# endpoint in application code; set it explicitly for another region/host.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Client/server DSNs may be the same. SENTRY_ORG/PROJECT enable build-time
# source map integration; SENTRY_AUTH_TOKEN is read by the Sentry build plugin.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional: Vercel Web Analytics on each project's Overview. Server-only;
# VERCEL_TEAM_ID is needed only when the Vercel projects belong to a team.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# NEXT_E2E is set by Playwright configuration and is not a production setting.

# Optional: import completed Apify job tasks (no paid runs are started by the app).
APIFY_TOKEN=
APIFY_JOB_TASK_IDS=

# Marketing generation (Claude through LangChain). Nothing is sent without consent.
MARKETING_AI_CONSENT=false
ANTHROPIC_API_KEY=
# Unset: claude-sonnet-5-5 at 2 / 10 USD per million input / output tokens.
# Another model needs both rates set. Saved-source analysis needs all three set.
MARKETING_CLAUDE_MODEL=
MARKETING_CLAUDE_INPUT_USD_PER_MTOK=
MARKETING_CLAUDE_OUTPUT_USD_PER_MTOK=
# DNESKAi generation spend allowed per rolling 24 hours, in USD (default 1.00, at most 50).
# Below one job's maximum (0.25) every DNESKAi call is refused.
MARKETING_DNESKAI_DAILY_GENERATION_USD=1.00

# Optional LangSmith diagnostics (#122): a redacted trace per generation and one feedback record per owner
# decision. Diagnostics only; the approval record is marketing_revisions.approved_hash. Hashes, counts, issue
# codes, cost and scores leave the app; prompts, captions, slide text, URLs, credits and owner notes never do.
# With the switch on, the key must belong to an EU workspace and the endpoint must be exactly the EU one, or the
# worker refuses jobs (langsmith-eu-configuration-required). A LangSmith outage never stops a job or a decision.
# Project name: letters, digits, - and _ only. Keep LANGSMITH_TRACING, LANGCHAIN_TRACING_V2, LANGCHAIN_TRACING
# and LANGCHAIN_VERBOSE unset: native tracing would capture prompts, so generation refuses to run with them.
MARKETING_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# DNESKAi research collection: separate from publisher/generation credentials. The pg_cron tick
# (POST /api/marketing/tick) is the only entry point and reads this switch.
MARKETING_DNESKAI_COLLECTION_ENABLED=false
# Unused: it opened POST /api/marketing/dneskai/collect, which answers 410 route-retired since the
# 22 October 2026 audit (finding cost-06). Delete it from Vercel; MARKETING_DNESKAI_MANUAL_SECRET,
# MARKETING_N8N_APPROVAL_WEBHOOK_URL and MARKETING_N8N_WEBHOOK_SECRET likewise open nothing. MARKETING_N8N_SECRET
# still opens the devShark and knowledge operations of /api/marketing/n8n (DNESKAi operations answer 410).
MARKETING_DNESKAI_COLLECTION_SECRET=
MARKETING_DNESKAI_PAID_ENABLED=false
# Feed collector: native fetches the 32 free feeds in this app (docs/dneskai-native-feeds.md); Production
# has used native since 21 October 2026. bridge, also the code default when unset, reads Quorum's signed
# source API, which Quorum turned off that evening (it answers 503 until re-enabled). Use native unless
# you are rolling back with Quorum's collection switch turned on again.
MARKETING_DNESKAI_FEED_PROVIDER=bridge
# Bridge only: Quorum origin and its shared signing secret (at least 32 characters).
MARKETING_DNESKAI_SOURCE_URL=
MARKETING_DNESKAI_SOURCE_SECRET=
TYPESAFE_API_KEY=
# Official apify/instagram-scraper expected actor ID and immutable build.
MARKETING_DNESKAI_APIFY_ACTOR_ID=
MARKETING_DNESKAI_APIFY_BUILD=
# Apify's own switch, on top of PAID_ENABLED and consent: only exactly true starts the Instagram stages.
# Anything else holds them with nothing reserved (collection-apify-disabled); free feeds and Jev still run.
MARKETING_DNESKAI_APIFY_ENABLED=false
# Existing owner and fixed pilot guards still apply. No extra pilot allowance.

# Manual Preview-only collection proof: explicit pilot:true body; regular collection may stay off.
# Retired 2026-10-20 (#113): read only when VERCEL_ENV=preview; elsewhere ignored with one `pilot-retired` log line.
# Unused since the collect route answers 410 route-retired (finding cost-06): no route admits a pilot run.
MARKETING_DNESKAI_COLLECTION_PILOT_ENABLED=false
MARKETING_DNESKAI_COLLECTION_PILOT_OWNER_ID=
MARKETING_DNESKAI_COLLECTION_PILOT_PROJECT_ID=
MARKETING_DNESKAI_COLLECTION_PILOT_STARTS_AT=
MARKETING_DNESKAI_COLLECTION_PILOT_EXPIRES_AT=
# One lifetime run, max48h, $0.24 total reservations. Original generation pilot is unchanged.

# DNESKAi Instagram publishing (#121). Server-only; mark the token Sensitive in Vercel.
# MARKETING_OWNER_ID is the owner's Supabase Auth user UUID; only that user can verify the account.
MARKETING_OWNER_ID=
# Both switches stay false until the owner authorizes the pilot (#123).
MARKETING_PUBLISH_ENABLED=false
MARKETING_DNESKAI_PUBLISH_ENABLED=false
# Exact public final-asset hosts, comma-separated, e.g. <project-ref>.supabase.co.
MARKETING_APPROVED_ASSET_HOSTS=
# Bootstrap long-lived Instagram Login token; after Verify account the stored token wins while valid.
MARKETING_DNESKAI_INSTAGRAM_ACCESS_TOKEN=
MARKETING_DNESKAI_INSTAGRAM_LOGIN_MODE=instagram
# vNN.0 confirmed for the app, and when it was confirmed (ISO 8601).
MARKETING_DNESKAI_INSTAGRAM_API_VERSION=
MARKETING_DNESKAI_INSTAGRAM_API_VERSION_VERIFIED_AT=
# Expiry and granted scopes as Meta's Access Token Debugger shows them.
MARKETING_DNESKAI_INSTAGRAM_TOKEN_EXPIRES_AT=
MARKETING_DNESKAI_INSTAGRAM_VERIFIED_SCOPES=instagram_business_basic,instagram_business_content_publish
# Optional: only when the handle is not dneskai.
MARKETING_DNESKAI_INSTAGRAM_HANDLE=

# Marketing scheduler (#120): pg_cron + pg_net call POST /api/marketing/tick with this secret, which
# must also be stored in Supabase Vault as marketing_scheduler_secret. At least 32 characters, used
# nowhere else. Empty disables the tick route. See docs/marketing-scheduling.md.
MARKETING_SCHEDULER_SECRET=

# Enable only after approved migration-history reconciliation and both richer-evidence migrations.
# Defaults off: preserves the existing media schema and brief/1 writer.
DNESKAI_RICH_EVIDENCE_ENABLED=false
