# Client-safe — exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# SERVER-ONLY — never expose. Required for Google token refresh
# (writes the per-user google_oauth row, bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# SERVER-ONLY — same Google OAuth client credentials configured in
# Supabase Auth > Providers > Google. Used to refresh access tokens
# against https://oauth2.googleapis.com/token.
GOOGLE_OAUTH_CLIENT_ID=xxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
